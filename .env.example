# SQLite database (Compose uses /data/cta.db)
CTA_DB_PATH=./data/cta.db
CTA_API_KEY=
# Optional CTA beta GTFS-Realtime key. Leave blank to use Train Tracker positions.
CTA_GTFS_API_KEY=
CTA_TELEMETRY_INTERVAL=30
CTA_ALERTS_INTERVAL=300
CTA_RETENTION_HOURS=24
CTA_LLM_ANOMALIES=false
CTA_DASHBOARD_PORT=8001

# Optional OpenAI-compatible structured extraction. Leave the key blank for local-only mode.
OPENAI_API_KEY=
# Normal API root for native and container use.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional native-only override of OPENAI_BASE_URL.
# OPENAI_NATIVE_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_MODEL=gpt-5-mini

# Optional editable /api/ask prompts; relative paths resolve from the process cwd.
CTA_ASK_PLANNER_PROMPT_FILE=
CTA_ASK_ANSWER_PROMPT_FILE=
